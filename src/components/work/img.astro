---
interface Props {
  images?: readonly string[];
  title?: string;
}

const {
  images = [],
  title = "Project",
} = Astro.props;

const isVideo = (src: string): boolean => /\.(mp4|webm)$/i.test(src);
---

<div
  data-gallery
  class="grid grid-cols-1 gap-4 sm:grid-cols-6"
>
  {
    images.map((src, index) => (
      <figure
        data-gallery-item
        data-original-index={index}
        class="col-span-1 m-0 min-w-0 sm:col-span-6"
      >
        {isVideo(src) ? (
          <video
            src={`${src}#t=0.001`}
            aria-label={`${title} project video ${index + 1}`}
            controls
            playsinline
            preload="metadata"
            class="block w-full max-w-full h-auto opacity-0 transition-opacity duration-300"
          />
        ) : (
          <img
            src={src}
            alt={`${title} project image ${index + 1}`}
            loading={index < 2 ? "eager" : "lazy"}
            decoding="async"
            class="block w-full max-w-full h-auto opacity-0 transition-opacity duration-300"
          />
        )}
      </figure>
    ))
  }
</div>

<script>
  type ImageShape = "wide" | "square" | "tall";
  type MediaElement = HTMLImageElement | HTMLVideoElement;

  interface GalleryItem {
    wrapper: HTMLElement;
    media: MediaElement;
    shape: ImageShape;
    originalIndex: number;
  }

  const initializedGalleries = new WeakSet<HTMLElement>();

  function getDimensions(media: MediaElement): {
    width: number;
    height: number;
  } {
    if (media instanceof HTMLVideoElement) {
      return { width: media.videoWidth, height: media.videoHeight };
    }

    return { width: media.naturalWidth, height: media.naturalHeight };
  }

  function classifyMedia(media: MediaElement): ImageShape {
    const { width, height } = getDimensions(media);

    if (width <= 0 || height <= 0) {
      return "square";
    }

    const ratio = width / height;

    if (!Number.isFinite(ratio) || ratio <= 0) {
      return "square";
    }

    if (ratio > 1.6) return "wide";
    if (ratio >= 0.8) return "square";

    return "tall";
  }

  function applyGridSpan(wrapper: HTMLElement, shape: ImageShape): void {
    wrapper.classList.remove(
      "sm:col-span-2",
      "sm:col-span-3",
      "sm:col-span-6",
    );

    switch (shape) {
      case "wide":
        wrapper.classList.add("sm:col-span-6");
        break;

      case "square":
        wrapper.classList.add("sm:col-span-3");
        break;

      case "tall":
        wrapper.classList.add("sm:col-span-2");
        break;
    }
  }

  function revealMedia(media: MediaElement): void {
    requestAnimationFrame(() => {
      if (!media.isConnected) return;

      media.classList.remove("opacity-0");
    });
  }

  function waitForMedia(media: MediaElement): Promise<boolean> {
    return new Promise((resolve) => {
      if (media instanceof HTMLVideoElement) {
        // HAVE_METADATA (1) = dimensioner og varighed er kendt
        if (media.readyState >= HTMLMediaElement.HAVE_METADATA) {
          resolve(media.videoWidth > 0);
          return;
        }

        const handleMetadata = (): void => {
          cleanup();
          resolve(media.videoWidth > 0);
        };

        const handleVideoError = (): void => {
          cleanup();
          resolve(false);
        };

        const cleanup = (): void => {
          media.removeEventListener("loadedmetadata", handleMetadata);
          media.removeEventListener("error", handleVideoError);
        };

        media.addEventListener("loadedmetadata", handleMetadata, {
          once: true,
        });
        media.addEventListener("error", handleVideoError, { once: true });

        // Sikrer at indlæsningen er startet, hvis Safari har udskudt den
        media.load();
        return;
      }

      /*
       * Safari kan sætte complete=true både for indlæste
       * og fejlede billeder. naturalWidth afgør resultatet.
       */
      if (media.complete) {
        resolve(media.naturalWidth > 0);
        return;
      }

      const handleLoad = (): void => {
        cleanup();
        resolve(media.naturalWidth > 0);
      };

      const handleError = (): void => {
        cleanup();
        resolve(false);
      };

      const cleanup = (): void => {
        media.removeEventListener("load", handleLoad);
        media.removeEventListener("error", handleError);
      };

      media.addEventListener("load", handleLoad, { once: true });
      media.addEventListener("error", handleError, { once: true });
    });
  }

  async function initializeGallery(gallery: HTMLElement): Promise<void> {
    if (initializedGalleries.has(gallery)) return;

    initializedGalleries.add(gallery);

    const wrappers = Array.from(
      gallery.querySelectorAll<HTMLElement>("[data-gallery-item]"),
    );

    if (wrappers.length === 0) return;

    const items = await Promise.all(
      wrappers.map(async (wrapper) => {
        const media = wrapper.querySelector<MediaElement>("img, video");

        if (!media) {
          wrapper.remove();
          return null;
        }

        const loaded = await waitForMedia(media);

        /*
         * Kontroller igen efter await, fordi ClientRouter kan
         * have fjernet siden, mens mediet blev indlæst.
         */
        if (
          !gallery.isConnected ||
          !wrapper.isConnected ||
          !media.isConnected
        ) {
          return null;
        }

        if (!loaded) {
          wrapper.remove();
          return null;
        }

        const shape = classifyMedia(media);

        applyGridSpan(wrapper, shape);
        revealMedia(media);

        const originalIndex = Number.parseInt(
          wrapper.dataset.originalIndex ?? "0",
          10,
        );

        return {
          wrapper,
          media,
          shape,
          originalIndex: Number.isFinite(originalIndex) ? originalIndex : 0,
        } satisfies GalleryItem;
      }),
    );

    if (!gallery.isConnected) return;

    const validItems = items.filter(
      (item): item is GalleryItem => item !== null,
    );

    const shapeOrder: Record<ImageShape, number> = {
      wide: 0,
      square: 1,
      tall: 2,
    };

    validItems.sort((a, b) => {
      const shapeDifference = shapeOrder[a.shape] - shapeOrder[b.shape];

      if (shapeDifference !== 0) {
        return shapeDifference;
      }

      return a.originalIndex - b.originalIndex;
    });

    const fragment = document.createDocumentFragment();

    for (const item of validItems) {
      fragment.appendChild(item.wrapper);
    }

    gallery.appendChild(fragment);
  }

  function initGalleries(): void {
    document
      .querySelectorAll<HTMLElement>("[data-gallery]")
      .forEach((gallery) => {
        void initializeGallery(gallery);
      });
  }

  initGalleries();

  document.addEventListener("astro:page-load", initGalleries);
</script>