---
interface Props {
  images?: readonly string[];
  title?: string;
}

const { images = [], title = "Project" } = Astro.props;
---

<div data-gallery class="grid grid-cols-1 sm:grid-cols-6 gap-4">
  {
    images.map((src, index) => (
      <img
        src={src}
        alt={`${title} project image ${index + 1}`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover opacity-0 transition-opacity duration-300"
      />
    ))
  }
</div>

<script>
  type ImageShape = "wide" | "square" | "tall";

  function initGalleries(): void {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      if (gallery.dataset.initialized === "true") return;
      gallery.dataset.initialized = "true";

      const images = Array.from(gallery.querySelectorAll<HTMLImageElement>("img"));
      if (images.length === 0) return;

      const classify = (ratio: number): ImageShape => {
        if (!Number.isFinite(ratio) || ratio <= 0) return "square";
        if (ratio > 1.6) return "wide";
        if (ratio >= 0.8) return "square";
        return "tall";
      };

      const spans: Record<ImageShape, string> = {
        wide: "sm:col-span-6",
        square: "sm:col-span-3",
        tall: "sm:col-span-2",
      };

      Promise.all(
        images.map(
          (image) =>
            new Promise<void>((resolve) => {
              if (image.complete) return resolve();
              image.addEventListener("load", () => resolve(), { once: true });
              image.addEventListener("error", () => resolve(), { once: true });
            }),
        ),
      ).then(() => {
        const order: Record<ImageShape, number> = { wide: 0, square: 1, tall: 2 };
        const sorted = [...images].sort((a, b) => {
          const aShape = classify(a.naturalWidth / a.naturalHeight);
          const bShape = classify(b.naturalWidth / b.naturalHeight);
          return order[aShape] - order[bShape];
        });

        for (const image of sorted) {
          gallery.appendChild(image);
          if (image.naturalWidth === 0) {
            image.remove();
            continue;
          }
          image.classList.add(spans[classify(image.naturalWidth / image.naturalHeight)]);
          image.classList.remove("opacity-0");
        }
      });
    });
  }

  initGalleries();
  document.addEventListener("astro:page-load", initGalleries);
</script>
