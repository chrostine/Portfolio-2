---
// work.astro
import Case from "./case.astro";
import { casearray } from "../../scripts/casearray";
---

<div class="case-scroll flex flex-row overflow-x-auto px-5 gap-5 pb-5">
  {
    casearray.map((c) => (
      <Case
        href={`${c.slug}`}
        video={c.video}
        titel={c.titel}
        tekst={c.displayText}
        programs={c.programs ?? []}
      />
    ))
  }
</div>


<script is:inline>
  const SCROLL_KEY = "case-scroll-position";

  function safeGetItem(key) {
    try {
      return sessionStorage.getItem(key);
    } catch (err) {
      console.warn("sessionStorage utilgængelig (get):", err);
      return null;
    }
  }

  function safeSetItem(key, value) {
    try {
      sessionStorage.setItem(key, value);
    } catch (err) {
      console.warn("sessionStorage utilgængelig (set):", err);
    }
  }

  function initHorizontalScroll() {
    const container = document.querySelector(".case-scroll");
    if (!container || container.dataset.scrollInitialized) return;
    container.dataset.scrollInitialized = "true";

    // --- Genopret gemt position FØRST, og brug den til at seede targetScroll/currentScroll ---
    const saved = safeGetItem(SCROLL_KEY);
    const savedValue = saved !== null ? parseInt(saved, 10) : NaN;
    const initial = Number.isFinite(savedValue) && savedValue >= 0
      ? savedValue
      : container.scrollLeft;

    let targetScroll = initial;
    let currentScroll = initial;
    let animating = false;
    let rafId = null;
    const ease = 0.08;

    container.scrollLeft = initial;

    // Layout er muligvis ikke helt klar lige efter view transition,
    // så vi korrigerer én gang mere på næste frame og clamper til det reelle maksimum.
    requestAnimationFrame(() => {
      const maxScroll = container.scrollWidth - container.clientWidth;
      const clamped = Math.min(Math.max(0, initial), maxScroll);
      container.scrollLeft = clamped;
      targetScroll = clamped;
      currentScroll = clamped;
    });

    function animate() {
      currentScroll += (targetScroll - currentScroll) * ease;

      if (Math.abs(targetScroll - currentScroll) < 0.5) {
        currentScroll = targetScroll;
        container.scrollLeft = currentScroll;
        animating = false;
        rafId = null;
        return;
      }

      container.scrollLeft = currentScroll;
      rafId = requestAnimationFrame(animate);
    }

    // --- Wheel/touchpad: konverter lodret scroll til vandret, med easing ---
    container.addEventListener(
      "wheel",
      (e) => {
        if (container.scrollWidth <= container.clientWidth) return;
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

        e.preventDefault();

        const maxScroll = container.scrollWidth - container.clientWidth;
        targetScroll = Math.min(
          Math.max(0, targetScroll + e.deltaY),
          maxScroll
        );

        if (!animating) {
          animating = true;
          rafId = requestAnimationFrame(animate);
        }
      },
      { passive: false }
    );

    // --- Touch: lad browseren håndtere selve swipet nativt ---
    let isTouching = false;

    container.addEventListener(
      "touchstart",
      () => {
        isTouching = true;
        animating = false;
        if (rafId) cancelAnimationFrame(rafId);
      },
      { passive: true }
    );

    container.addEventListener(
      "touchend",
      () => {
        isTouching = false;
        targetScroll = container.scrollLeft;
        currentScroll = container.scrollLeft;
      },
      { passive: true }
    );

    // --- Fælles: gem position løbende, uanset input-metode ---
    container.addEventListener(
      "scroll",
      () => {
        if (isTouching) {
          targetScroll = container.scrollLeft;
          currentScroll = container.scrollLeft;
        }
        safeSetItem(SCROLL_KEY, String(container.scrollLeft));
      },
      { passive: true }
    );
  }

  initHorizontalScroll();
  document.addEventListener("astro:page-load", initHorizontalScroll);
</script>