---
import Case from "./case.astro";
import { casearray } from "../../scripts/casearray";
---

<div data-case-scroll class="case-scroll flex flex-row overflow-x-auto px-5 gap-5 pb-5">
  {
    casearray.map((item) => (
      <Case
        href={`/${encodeURIComponent(item.slug)}`}
        slug={item.slug}
        video={item.video}
        titel={item.titel}
        tekst={item.displayText}
        programs={item.programs}
      />
    ))
  }
</div>

<script>
  const SCROLL_KEY = "case-scroll-position";

  function safeGetItem(key: string): string | null {
    try {
      return window.sessionStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function safeSetItem(key: string, value: string): void {
    try {
      window.sessionStorage.setItem(key, value);
    } catch {
      // Storage kan være slået fra uden at siden skal fejle.
    }
  }

  function initHorizontalScroll(): void {
    document.querySelectorAll<HTMLElement>("[data-case-scroll]").forEach((container) => {
      if (container.dataset.scrollInitialized === "true") return;
      container.dataset.scrollInitialized = "true";

      const savedValue = Number.parseInt(safeGetItem(SCROLL_KEY) ?? "", 10);
      const initial = Number.isFinite(savedValue) && savedValue >= 0
        ? savedValue
        : container.scrollLeft;

      let targetScroll = initial;
      let currentScroll = initial;
      let animationFrame: number | null = null;
      let touching = false;
      const ease = 0.08;

      const clamp = (value: number): number => {
        const max = Math.max(0, container.scrollWidth - container.clientWidth);
        return Math.min(Math.max(0, value), max);
      };

      const animate = (): void => {
        currentScroll += (targetScroll - currentScroll) * ease;
        if (Math.abs(targetScroll - currentScroll) < 0.5) {
          currentScroll = targetScroll;
          container.scrollLeft = currentScroll;
          animationFrame = null;
          return;
        }
        container.scrollLeft = currentScroll;
        animationFrame = window.requestAnimationFrame(animate);
      };

      window.requestAnimationFrame(() => {
        const clamped = clamp(initial);
        container.scrollLeft = clamped;
        targetScroll = clamped;
        currentScroll = clamped;
      });

      container.addEventListener("wheel", (event) => {
        if (container.scrollWidth <= container.clientWidth) return;
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

        event.preventDefault();
        targetScroll = clamp(targetScroll + event.deltaY);
        if (animationFrame === null) {
          animationFrame = window.requestAnimationFrame(animate);
        }
      }, { passive: false });

      container.addEventListener("touchstart", () => {
        touching = true;
        if (animationFrame !== null) {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = null;
        }
      }, { passive: true });

      container.addEventListener("touchend", () => {
        touching = false;
        targetScroll = container.scrollLeft;
        currentScroll = container.scrollLeft;
      }, { passive: true });

      container.addEventListener("scroll", () => {
        if (touching) {
          targetScroll = container.scrollLeft;
          currentScroll = container.scrollLeft;
        }
        safeSetItem(SCROLL_KEY, String(Math.round(container.scrollLeft)));
      }, { passive: true });
    });
  }

  initHorizontalScroll();
  document.addEventListener("astro:page-load", initHorizontalScroll);
</script>
