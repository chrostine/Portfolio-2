---
import type { Case } from "../scripts/casearray";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/UI/nav.astro";
import Footer from "../components/UI/footer.astro";
import Knap from "../components/UI/knap.astro";
import Img from "../components/work/img.astro";
import Overskrift from "../components/text/overskrift.astro";
import Underoverskrift from "../components/text/underoverskrift.astro";
import Brodtekst from "../components/text/brodtekst.astro";
import { casearray } from "../scripts/casearray";

export function getStaticPaths() {
  return casearray.map((caseData) => ({
    params: { slug: caseData.slug },
    props: { caseData },
  }));
}

interface Props {
  caseData: Case;
}

const { caseData } = Astro.props;
const { titel, video, text, imgdisplay, date, programs, url } = caseData;
const transitionName = `case-img-${caseData.slug}`;
---

<Layout
  title={`${titel} | Chrostine's portfolio`}
  description={caseData.displayText}
>
  <div>
    <Nav />

    <main class="mx-auto max-w-7xl grid gap-25 pb-25 globalpy-15">
      <div class="grid gap-5 place-items-center">
  <div
    transition:name={transitionName}
    transition:animate="fade"
  >
    <video
      src={video}
      data-case-hero-video
      aria-label={`Project video for ${titel}`}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
  </div>

  {url && <Knap url={url} tekst="try it yourself" />}
</div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-15 px-5">
        <div>
          <Overskrift><h1>{titel}</h1></Overskrift>
          <Underoverskrift><time datetime={date}>{date}</time></Underoverskrift>
          <Underoverskrift><p>{programs.join(", ")}</p></Underoverskrift>
        </div>

        <div class="md:px-0 px-10">
          <Brodtekst>
            {text.map((paragraph) => <p>{paragraph}</p>)}
          </Brodtekst>
        </div>
      </div>

      <Img images={imgdisplay} title={titel} />
    </main>

    <Footer />
  </div>
</Layout>

<script>
  let heroVideoFrame: number | null = null;

  function sourceNeedsLoading(video: HTMLVideoElement): boolean {
    if (video.readyState === HTMLMediaElement.HAVE_NOTHING) return true;
    if (!video.currentSrc) return true;

    try {
      return new URL(video.currentSrc).href !== new URL(video.src).href;
    } catch {
      return false;
    }
  }

  async function startHeroVideo(video: HTMLVideoElement): Promise<void> {
    if (!video.isConnected) return;

    try {
      if (sourceNeedsLoading(video)) {
        video.load();
      }

      await video.play();
    } catch (error) {
      if (
        error instanceof DOMException &&
        ["AbortError", "NotAllowedError"].includes(error.name)
      ) {
        return;
      }

      console.warn("Hero-videoen kunne ikke afspilles:", error);
    }
  }

  function initHeroVideo(): void {
    if (heroVideoFrame !== null) {
      window.cancelAnimationFrame(heroVideoFrame);
    }

    // Vent til ClientRouter har afsluttet DOM-swap og transition.
    heroVideoFrame = window.requestAnimationFrame(() => {
      heroVideoFrame = window.requestAnimationFrame(() => {
        heroVideoFrame = null;

        const video = document.querySelector<HTMLVideoElement>(
          "[data-case-hero-video]",
        );

        if (video) {
          void startHeroVideo(video);
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initHeroVideo);
</script>
