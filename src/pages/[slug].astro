---
// slug.astro
import Layout from "../layouts/Layout.astro";
import Nav from "../components/UI/nav.astro";
import Footer from "../components/UI/footer.astro";
import Knap from "../components/UI/knap.astro";

import Img from "../components/work/img.astro";

import Overskrift from "../components/text/overskrift.astro";
import Underoverskrift from "../components/text/underoverskrift.astro";
import Brodtekst from "../components/text/brodtekst.astro";

import { casearray } from "../scripts/casearray";

export async function getStaticPaths() {
  return casearray
    .filter((c) => {
      if (!c.slug) {
        console.warn("Case uden slug er sprunget over:", c.titel ?? c);
        return false;
      }
      return true;
    })
    .map((c) => ({
      params: { slug: c.slug },
      props: { caseData: c },
    }));
}

const { caseData } = Astro.props;
const {
  titel,
  video,
  text = [],
  imgdisplay = [],
  date,
  programs = [],
  url,
} = caseData;
---

<Layout>
  <div>
    <Nav />
    <div class="mx-auto max-w-7xl grid gap-25 pb-25 globalpy-15">
      <div class="grid gap-5 place-items-center">
        <video
          src={video}
          id="case-hero-img"
          autoplay
          muted
          loop
          playsinline
          transition:name={`case-img-${titel}`}></video>
        {url && <Knap url={url} tekst="try it yourself" />}
      </div>
      <!-- tekst indhold -->

      <div class="grid grid-cols-1 md:grid-cols-2 gap-15 px-5">
        <div>
          <Overskrift><h2>{titel}</h2></Overskrift>
          <Underoverskrift><h3>{date}</h3></Underoverskrift>
          <Underoverskrift><h3>{programs.join(", ")}</h3></Underoverskrift>
        </div>
        <div class="md:px-0 px-10">
          <Brodtekst>{text.map((paragraph) => <p>{paragraph}</p>)}</Brodtekst>
        </div>
      </div>
      <Img images={imgdisplay} />
    </div>

    <Footer />
  </div>
</Layout>

<script>
  function initHeroVideo() {
    const video = document.getElementById("case-hero-img") as HTMLVideoElement | null;
    if (!video) return;
    if (video.dataset.initialized) return;
    video.dataset.initialized = "true";

    video.load();
    const p = video.play();
    if (p) p.catch(() => {});
  }

  initHeroVideo();
  document.addEventListener("astro:page-load", initHeroVideo);
</script>